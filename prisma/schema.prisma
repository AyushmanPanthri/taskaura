// ============================================================
// TaskAura — Canonical Production Prisma Schema (PostgreSQL)
// Maps to TaskAura / LifeXP Logic System File v2 §19
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  displayName  String?  @default("Adventurer") @map("name") @db.VarChar(100)
  email        String?  @unique @map("email") @db.VarChar(255)
  passwordHash String?  @map("password_hash")
  isGuest      Boolean  @default(false) @map("is_guest")
  avatar       String?  @default("🧑‍💻") @map("avatar") @db.VarChar(50)
  role         Role     @default(USER) @map("role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  accounts         Account[]
  sessions         Session[]
  settings         UserSettings?
  usageSessions    UsageSession[]
  goals            Goal[]
  tasks            Task[]
  habits           Habit[]
  dailyMetrics     DailyMetrics[]
  focusSessions    FocusSession[]
  xpTransactions   XPTransaction[]
  userAchievements UserAchievement[]
  quests           Quest[]
  questAssignments QuestAssignment[]
  aiInsights       AIInsight[]
  weeklyScores     WeeklyScore[]
  syncLogs         SyncLog[]
  streakRecord        StreakRecord?
  blocklistedDomains  BlocklistedDomain[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String  @default("oauth")
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @map("session_token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model UserSettings {
  id                  String  @id @default(uuid()) @db.Uuid
  userId              String  @unique @db.Uuid
  dailyGoalXp         Int     @default(500)
  weekdayWeekendSplit Boolean @default(false)
  retentionDays       Int     @default(90)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageSession {
  id              String   @id @default(uuid()) @db.Uuid
  clientEventId   String   @unique // §3 v2: dedup key
  userId          String   @db.Uuid
  packageName     String
  appName         String
  startTime       DateTime
  endTime         DateTime
  durationSeconds Int
  date            String   // YYYY-MM-DD, timezone-aware
  category        String?
  source          String
  syncStatus      String   @default("PENDING")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Goal {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  title        String
  description  String?
  category     String?
  targetValue  Float
  currentValue Float    @default(0)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  description String?
  difficulty  String    @default("NORMAL")
  status             String    @default("PENDING")
  startedAt          DateTime?
  completedAt        DateTime?
  estimatedMinutes   Int       @default(30)
  completionAttempts Int       @default(0)
  dueAt              DateTime?
  source             String    @default("USER")
  questId            String?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Habit {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  title         String
  frequency     String    @default("DAILY")
  streakCurrent Int       @default(0)
  streakBest    Int       @default(0)
  createdAt     DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitLogs HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String  @id @default(uuid()) @db.Uuid
  habitId   String  @db.Uuid
  date      String  // YYYY-MM-DD
  completed Boolean

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
}

model DailyMetrics {
  id                 String @id @default(uuid()) @db.Uuid
  userId             String @db.Uuid
  date               String // YYYY-MM-DD
  totalScreenTime    Int    @default(0)  // seconds
  appOpens           Int    @default(0)
  focusMinutes       Float  @default(0)
  taskCompletionRate Float  @default(0)
  // §6 — Behavioral metrics
  distractionIndex   Float  @default(0)
  focusScore         Float  @default(0)
  consistencyScore   Float  @default(0)
  goalAlignment      Float  @default(0)
  taskReliability    Float  @default(0)
  routineStability   Float  @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // §4: idempotent aggregation
  @@index([userId, date])
}

model FocusSession {
  id                 String    @id @default(uuid()) @db.Uuid
  clientEventId      String    @unique // dedup key
  userId             String    @db.Uuid
  status             String    @default("RUNNING")
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  requiredMinutes    Int
  actualMinutes      Float     @default(0)
  heartbeatCount     Int       @default(0)
  expectedHeartbeats Int       @default(0)
  lastHeartbeatAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model XPTransaction {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  amount               Int
  sourceType           String
  sourceId             String
  rewardType           String
  idempotencyKey       String   // §9.3 v2: payout:{rootType}:{rootId}
  baseXp               Int
  difficultyMultiplier Float
  streakBonus          Int      @default(0)
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model Achievement {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  description String
  ruleVersion Int    @default(1)
  condition   String // JSON: { type, threshold }

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  achievementId String   @db.Uuid
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model Quest {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  title          String
  description    String
  difficulty     String    @default("NORMAL")
  status         String    @default("ACTIVE")
  triggeringRule String    @default("ADMIN_CREATED") // AIRuleId | ADMIN_CREATED
  sourceMetrics  String    @default("{}") // JSON
  createdAt      DateTime  @default(now())
  // Admin-forge extensions (nullable — backward-compatible with existing AI quests)
  xpReward       Int?      // XP awarded on completion
  deadline       DateTime? // optional quest deadline
  targetType     String?   @default("PERSONAL") // PERSONAL | SPECIFIC | GLOBAL
  createdByAdmin String?   @db.Uuid // adminUserId if forged by admin

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questAssignments QuestAssignment[]

  @@index([userId, status])
  @@index([targetType, status])
}

model QuestAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  questId    String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now())

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questId, userId])
  @@index([userId])
  @@index([questId])
}

model AdminAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  adminUserId   String   @db.Uuid
  action        String   // QUEST_CREATED | QUEST_UPDATED | QUEST_ASSIGNED | XP_GRANTED | ACHIEVEMENT_GRANTED
  targetUserId  String?  @db.Uuid
  targetQuestId String?  @db.Uuid
  metadata      String   @default("{}") // JSON — NEVER contains passwords, hashes, or tokens
  createdAt     DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([createdAt])
}

model AIInsight {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  type              String   // insight | recommendation | quest
  content           String
  sourceMetricsJson String   // JSON: triggering metrics
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WeeklyScore {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  weekStart  String   // YYYY-MM-DD
  weekEnd    String   // YYYY-MM-DD
  totalXp    Int      @default(0)
  rank       Int      @default(0)
  snapshotAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([weekStart, totalXp])
}

model TaskTypeConfig {
  id     String  @id @default(uuid()) @db.Uuid
  type   String  @unique
  baseXp Int
  active Boolean @default(true)
}

model SyncLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  clientEventId String
  receivedAt    DateTime @default(now())
  status        String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientEventId])
}

model StreakRecord {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @unique @db.Uuid
  currentStreak     Int     @default(0)
  bestStreak        Int     @default(0)
  lastEligibleDate  String? // YYYY-MM-DD
  graceUsedThisWeek Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Extension: Site-Blocking Focus Enforcement ───────────────
// Stores user-configured distraction domains blocked during focus sessions.
// Managed via /api/v1/extension/blocklist (GET/POST/DELETE).
// Queried by the browser extension background service worker on each poll.
model BlocklistedDomain {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  domain    String   @db.VarChar(255)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId])
  @@map("blocklisted_domains")
}
