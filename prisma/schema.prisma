}

model XPTransaction {
  id                   String   @id @default(uuid())
  userId               String
  amount               Int
  sourceType           String
  sourceId             String
  rewardType           String
  idempotencyKey       String   @unique  // §9 v2: hash(sourceType+sourceId+rewardType)
  baseXp               Int
  difficultyMultiplier Float
  streakBonus          Int      @default(0)
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([sourceType, sourceId, rewardType])  // §9 v2: DB-level uniqueness
}

model Achievement {
  id          String @id @default(uuid())
  name        String
  description String
  ruleVersion Int    @default(1)
  condition   String // JSON: { type, threshold }

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])  // §13 v2: one unlock per achievement
}

model Quest {
  id             String   @id @default(uuid())
  userId         String
  title          String
  description    String
  difficulty     String   @default("NORMAL")
  status         String   @default("ACTIVE")
  triggeringRule  String   // AIRuleId
  sourceMetrics  String   // JSON
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AIInsight {
  id                String   @id @default(uuid())
  userId            String
  type              String   // insight | recommendation | quest
  content           String
  sourceMetricsJson String   // JSON: triggering metrics
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model WeeklyScore {
  id         String   @id @default(uuid())
  userId     String
  weekStart  String   // YYYY-MM-DD
  weekEnd    String   // YYYY-MM-DD
  totalXp    Int      @default(0)
  rank       Int      @default(0)
  snapshotAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, weekStart])
}

// §19 v2 — Task type config (tunable XP economy)
